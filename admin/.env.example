APP_ENV=development
APP_DEBUG=true
APP_NAME=KaraOK Admin Console
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=Asia/Manila
SESSION_NAME=karaok_admin
SESSION_IDLE_MINUTES=30

# The local console calls Flask over HTTPS. It never connects to MySQL.
ADMIN_API_BASE_URL=https://139.99.89.112/api/admin/data
ADMIN_API_KEY=<RAW_ADMIN_API_KEY>
ADMIN_API_VERIFY_TLS=true
ADMIN_API_CONNECT_TIMEOUT=5
ADMIN_API_TIMEOUT=20

PRIVACY_MODE=true
