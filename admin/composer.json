{
  "name": "karaok/local-admin",
  "description": "Local analytics and controlled CRUD console for the KaraOK Data Administration API.",
  "license": "proprietary",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "ext-curl": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*"
  },
  "autoload": {
    "psr-4": {
      "KaraOK\\Admin\\": "app/"
    }
  },
  "scripts": {
    "test": "php tests/run.php",
    "serve": "php -S 127.0.0.1:8080 -t public public/router.php"
  },
  "config": {
    "sort-packages": true
  }
}
