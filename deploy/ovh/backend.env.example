DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=karaok_db
DB_USER=karaok_app
DB_PASSWORD=replace-with-the-production-database-password

JWT_SECRET=replace-with-a-generated-secret-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

FLASK_DEBUG=false
DEV_MODE=false
SETTINGS_RECOMMENDATIONS_ENABLED=false
EXPOSE_REGISTRATION_OTP=false
TRUST_PROXY=true

# Native Android requests do not use browser CORS. Keep this restricted if a
# Flutter Web client is deployed later.
CORS_ORIGINS=https://139.99.89.112
RATELIMIT_STORAGE_URI=memory://

# Copy the same provider settings used by the existing local backend/.env.
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-app-password-or-api-key
SMTP_FROM=replace-with-verified-sender
REGISTRATION_OTP_MINUTES=10

AUDIO_UPLOAD_DIR=/var/lib/karaok/uploads
MAX_AUDIO_BYTES=27262976
MAX_PROFILE_IMAGE_BYTES=5242880
AUDIO_ANALYSIS_OUTPUT_DIR=/var/lib/karaok/uploads/_analysis
AUDIO_ANALYSIS_TIMEOUT_SECONDS=300

# Nightly retention cleanup (karaok-retention.timer). 0 keeps forever.
REQUEST_LOG_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365
VISUALIZATION_RETENTION_DAYS=0

# Authentication and OTP limits. ALLOWED_EMAIL_DOMAINS replaces the signup allowlist.
OTP_RESEND_COOLDOWN_SECONDS=300
OTP_MAX_SENDS_PER_EMAIL_PER_HOUR=4
OTP_MAX_SENDS_PER_DEVICE_PER_HOUR=10
OTP_MAX_SENDS_PER_IP_PER_HOUR=30
OTP_MAX_VERIFY_ATTEMPTS=5
AUTH_BURST_LIMIT=5
AUTH_BURST_WINDOW_SECONDS=30
AUTH_LOCKOUT_FIRST_SECONDS=30
AUTH_LOCKOUT_REPEAT_SECONDS=60
AUTH_STRIKE_RESET_SECONDS=900
AUTH_IP_CEILING_PER_MINUTE=120
LOGIN_ACCOUNT_FAIL_LIMIT=20
LOGIN_ACCOUNT_FAIL_WINDOW_SECONDS=900
ALLOWED_EMAIL_DOMAINS=gmail.com,googlemail.com,yahoo.com,yahoo.com.ph,ymail.com,rocketmail.com,outlook.com,hotmail.com,live.com,msn.com,icloud.com,me.com,mac.com,proton.me,protonmail.com,aol.com,zoho.com,gmx.com,mail.com,yandex.com
