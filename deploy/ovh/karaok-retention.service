[Unit]
Description=Delete old KaraOK log rows, expired tokens and old report images
After=mysql.service
Requires=mysql.service

[Service]
Type=oneshot
User=karaok
Group=karaok
WorkingDirectory=/opt/karaok/app/backend
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/karaok/app/backend/.venv/bin/python scripts/purge_old_records.py
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/karaok/uploads
