DB_HOST=localhost
DB_PORT=3306
DB_NAME=karaok_db
DB_USER=karaok_app
DB_PASSWORD=replace-with-a-strong-database-password
# Data Administration API: disabled unless all values below are configured.
ADMIN_DATA_API_ENABLED=false
ADMIN_DATA_API_KEY_HASH=replace-with-a-sha256-hash-of-a-random-api-key
ADMIN_DATA_API_QUERY_TIMEOUT_MS=5000
ADMIN_DB_HOST=localhost
ADMIN_DB_PORT=3306
ADMIN_DB_NAME=karaok_db
ADMIN_DB_USER=karaok_admin_api
ADMIN_DB_PASSWORD=replace-with-password-b
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:*
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
APP_HOST=127.0.0.1
APP_PORT=5000
FLASK_DEBUG=false
DEV_MODE=false
SETTINGS_RECOMMENDATIONS_ENABLED=false
# Never expose OTPs in production responses.
EXPOSE_REGISTRATION_OTP=false
# Enable only when the API is bound to loopback behind the trusted Nginx config.
TRUST_PROXY=false
RATELIMIT_STORAGE_URI=memory://
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=no-reply@example.com
REGISTRATION_OTP_MINUTES=10
PASSWORD_RESET_MINUTES=15
AUDIO_UPLOAD_DIR=uploads
MAX_AUDIO_BYTES=27262976
MAX_PROFILE_IMAGE_BYTES=5242880
AUDIO_ANALYSIS_OUTPUT_DIR=uploads/_analysis
AUDIO_ANALYSIS_TIMEOUT_SECONDS=300

# Authentication and OTP limits. ALLOWED_EMAIL_DOMAINS replaces the signup allowlist.
OTP_RESEND_COOLDOWN_SECONDS=300
OTP_MAX_SENDS_PER_EMAIL_PER_HOUR=4
OTP_MAX_SENDS_PER_DEVICE_PER_HOUR=10
OTP_MAX_SENDS_PER_IP_PER_HOUR=30
OTP_MAX_VERIFY_ATTEMPTS=5
AUTH_BURST_LIMIT=5
AUTH_BURST_WINDOW_SECONDS=30
AUTH_LOCKOUT_FIRST_SECONDS=30
AUTH_LOCKOUT_REPEAT_SECONDS=60
AUTH_STRIKE_RESET_SECONDS=900
AUTH_IP_CEILING_PER_MINUTE=120
LOGIN_ACCOUNT_FAIL_LIMIT=20
LOGIN_ACCOUNT_FAIL_WINDOW_SECONDS=900
ALLOWED_EMAIL_DOMAINS=gmail.com,googlemail.com,yahoo.com,yahoo.com.ph,ymail.com,rocketmail.com,outlook.com,hotmail.com,live.com,msn.com,icloud.com,me.com,mac.com,proton.me,protonmail.com,aol.com,zoho.com,gmx.com,mail.com,yandex.com
