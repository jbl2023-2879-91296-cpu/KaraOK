DB_HOST=localhost
DB_PORT=3306
DB_NAME=karaok_db
DB_USER=karaok_app
DB_PASSWORD=replace-with-a-strong-database-password
# Data Administration API: disabled unless all values below are configured.
ADMIN_DATA_API_ENABLED=false
ADMIN_DATA_API_KEY_HASH=replace-with-a-sha256-hash-of-a-random-api-key
ADMIN_DATA_API_QUERY_TIMEOUT_MS=5000
ADMIN_DB_HOST=localhost
ADMIN_DB_PORT=3306
ADMIN_DB_NAME=karaok_db
ADMIN_DB_USER=karaok_admin_api
ADMIN_DB_PASSWORD=replace-with-password-b
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:*
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
APP_HOST=127.0.0.1
APP_PORT=5000
FLASK_DEBUG=false
DEV_MODE=false
# Never expose OTPs in production responses.
EXPOSE_REGISTRATION_OTP=false
# Enable only when the API is bound to loopback behind the trusted Nginx config.
TRUST_PROXY=false
RATELIMIT_STORAGE_URI=memory://
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=no-reply@example.com
REGISTRATION_OTP_MINUTES=10
PASSWORD_RESET_MINUTES=15
AUDIO_UPLOAD_DIR=uploads
MAX_AUDIO_BYTES=26214400
MAX_PROFILE_IMAGE_BYTES=5242880
AUDIO_ANALYSIS_OUTPUT_DIR=uploads/_analysis
AUDIO_ANALYSIS_TIMEOUT_SECONDS=300
